datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum KycStatus {
  PENDING
  VERIFIED
  APPROVED
  REJECTED
}

enum TransactionType {
  P2P_TRANSFER
  ESCROW_LOCK
  ESCROW_RELEASE
}

enum EscrowStatus {
  PENDING
  IN_PROGRESS
  RELEASED
  REFUNDED
}

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  handle        String?   @unique
  passwordHash  String?
  walletAddress String?   @unique
  kycVerified   Boolean   @default(true)
  kycStatus     KycStatus @default(APPROVED)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sentTransactions     Transaction[]    @relation("SentTx")
  receivedTransactions Transaction[]    @relation("ReceivedTx")
  payerEscrows         EscrowContract[] @relation("PayerEscrow")
  beneficiaryEscrows   EscrowContract[] @relation("BeneficiaryEscrow")
  invoices             Invoice[]
  transactionLogs      TransactionLog[]
}

model Transaction {
  id          String          @id @default(uuid())
  txHash      String?         @unique
  type        TransactionType @default(P2P_TRANSFER)
  amount      Float
  fee         Float           @default(0.001)
  status      String          @default("CONFIRMED")
  senderId    String
  sender      User            @relation("SentTx", fields: [senderId], references: [id])
  recipientId String
  recipient   User            @relation("ReceivedTx", fields: [recipientId], references: [id])
  createdAt   DateTime        @default(now())
}

model TransactionLog {
  id        String   @id @default(uuid())
  txHash    String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  amount    Float?
  status    String   @default("CONFIRMED")
  data      String?
  createdAt DateTime @default(now())
}

model Invoice {
  id          String   @id @default(uuid())
  issuerId    String
  issuer      User     @relation(fields: [issuerId], references: [id])
  amount      Float
  description String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EscrowContract {
  id             String       @id @default(uuid())
  contractTxHash String?      @unique
  amount         Float
  condition      String
  progress       Int          @default(0)
  status         EscrowStatus @default(PENDING)
  payerId        String
  payer          User         @relation("PayerEscrow", fields: [payerId], references: [id])
  beneficiaryId  String
  beneficiary    User         @relation("BeneficiaryEscrow", fields: [beneficiaryId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}